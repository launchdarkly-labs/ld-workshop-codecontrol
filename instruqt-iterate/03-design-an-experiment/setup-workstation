#!/bin/bash
#
# Runs when the challenge starts. Prepares the solve module and keeps traffic
# flowing. Does NOT create the experiment.
#
set -euo pipefail
source /opt/ld/ld.env
TF=/opt/ld/codecontrol/terraform
cd "$TF/iterate-03"
echo "project_key = \"${LD_PROJECT_KEY}\"" > terraform.tfvars
terraform init -input=false
systemctl is-active --quiet togglewear-traffic || bash "$TF/lib/traffic.sh" exp
exit 0
