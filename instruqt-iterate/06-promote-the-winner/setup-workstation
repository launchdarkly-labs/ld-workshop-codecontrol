#!/bin/bash
#
# Runs when the challenge starts. Prepares the solve module; keeps traffic
# flowing so a learner whose results haven't converged yet gets there.
#
set -euo pipefail
TF=/opt/ld/codecontrol/terraform
cd "$TF/iterate-06"
echo "project_key = \"${LD_PROJECT_KEY}\"" > terraform.tfvars
terraform init -input=false
systemctl is-active --quiet togglewear-traffic || bash "$TF/lib/traffic.sh" exp
exit 0
