#!/bin/bash
#
# Verify the experiment on recommendations-strategy has a running iteration
# (or, for a fast learner who already shipped, a stopped one with a winner).
#
# Lifecycle scripts don't inherit ~/.profile; the track setup wrote the keys here.
source /opt/ld/ld.env

STATUS=$(curl -s -o /tmp/ck-itr04.json -w '%{http_code}' -X GET \
  "https://app.launchdarkly.com/api/v2/projects/$LD_PROJECT_KEY/environments/test/experiments?filter=flagKey:recommendations-strategy&expand=currentIteration" \
  -H 'Authorization: '$LAUNCHDARKLY_ACCESS_TOKEN)
if [ "$STATUS" != "200" ]; then
  fail-message "Couldn't reach the LaunchDarkly API (HTTP $STATUS). Click Check again in a few seconds; if it keeps happening, tell your instructor."
  exit 1
fi
if [ "$(jq '[.items[]? | select((.type // "experiment") == "experiment")] | length' /tmp/ck-itr04.json)" == "0" ]; then
  fail-message "There's no experiment on recommendations-strategy. Go back to the previous lab and create one (or restart it and click Skip), then start it here."
  exit 1
fi
RUNNING=$(jq '[.items[]? | select((.type // "experiment") == "experiment") | select(.currentIteration.status == "running")] | length' /tmp/ck-itr04.json)
SHIPPED=$(jq '[.items[]? | select((.type // "experiment") == "experiment") | select(.currentIteration.status == "stopped" and (.currentIteration.winningTreatmentId // "") != "")] | length' /tmp/ck-itr04.json)
if [ "$RUNNING" == "0" ] && [ "$SHIPPED" == "0" ]; then
  fail-message "Your experiment exists but hasn't been started. Open it from the Experiments list, click Start, then Start experiment."
  exit 1
fi
exit 0
