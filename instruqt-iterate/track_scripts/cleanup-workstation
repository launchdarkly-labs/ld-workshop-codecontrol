#!/bin/bash
#
# Track cleanup: REQUIRED (launchdarkly-instruqt-track contract). Destroys the
# learner's LaunchDarkly project, team member, and DynamoDB login records.
# Must run in the directory holding the Terraform state written by
# track_scripts/setup-workstation. A destroy failure must propagate (non-zero
# exit) so Instruqt retries — silent failures accumulate orphaned projects.
#
cd /opt/ld/ld-workshop-participant || exit 1
terraform destroy -auto-approve || exit 1

exit 0
