#!/bin/bash
#
# Runs when the challenge starts. Prepares the solve module and keeps the
# experiment traffic profile running so the bandit has fresh exposures to
# reallocate on. Does NOT create the bandit.
#
set -euo pipefail
TF=/opt/ld/codecontrol/terraform
cd "$TF/iterate-07"
echo "project_key = \"${LD_PROJECT_KEY}\"" > terraform.tfvars
terraform init -input=false
bash "$TF/lib/traffic.sh" exp
exit 0
