# Solve for 06-guarded-release-real-metrics: a guarded (monitored) release
# of the "personalized" strategy on recommendations-strategy, started via
# the beta release APIs (see DECISIONS.md, "Rollout solves use the beta
# release APIs"). The metric that guards it — LaunchDarkly's autogenerated
# User HTTP error rate — is created by LaunchDarkly, not Terraform.
resource "null_resource" "start_guarded_rollout" {
  triggers = {
    always = timestamp()
  }

  provisioner "local-exec" {
    command = "bash ${path.module}/../lib/start-guarded-rollout.sh ${var.project_key} recommendations-strategy personalized recs-guarded-pipeline 'Recommendations guarded pipeline'"
  }
}
