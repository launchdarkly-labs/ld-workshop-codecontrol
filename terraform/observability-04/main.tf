# Solve for 04-release-monitoring: the learner, having read the release
# health numbers, reverts recommendations-strategy's default rule to the
# safe "bestsellers" variation (the right thing to do before re-releasing
# it guarded in 06).
#
# The autogenerated error-rate metrics the lab reads are created by
# LaunchDarkly from the plugin's traces — nothing for Terraform to create.
resource "null_resource" "revert_to_bestsellers" {
  triggers = {
    always = timestamp()
  }

  provisioner "local-exec" {
    command = "bash ${path.module}/../lib/set-fallthrough.sh ${var.project_key} recommendations-strategy bestsellers"
  }
}
