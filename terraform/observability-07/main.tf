# Solve for 07-auto-remediation: the HEALED end-state only.
#
# The learner's artifact is an adaptive trigger on recommendations-strategy's
# default rule (source: the autogenerated User HTTP error rate; action:
# switch to bestsellers). Creating one over REST requires an observability
# alert id, and observability alerts have no public API (the trigger UI
# creates the alert implicitly) — see PHASES-observability.md Phase 0 §5 and
# the matching entry in DECISIONS.md. So this solve materializes what the
# trigger would have produced after firing (default rule on bestsellers),
# logs loudly that the trigger itself must be created in the UI, and exits
# 0. The check still requires a real trigger, so Skip → Check fails
# honestly; operator-accepted trade-off.
resource "null_resource" "healed_end_state" {
  triggers = {
    always = timestamp()
  }

  provisioner "local-exec" {
    command = <<-EOT
      bash ${path.module}/../lib/set-fallthrough.sh ${var.project_key} recommendations-strategy bestsellers
      echo "WARNING: 07 solve materialized the healed end-state (bestsellers) only." >&2
      echo "WARNING: adaptive triggers cannot be created via the public API; create one in the UI if a live trigger is needed." >&2
    EOT
  }
}
