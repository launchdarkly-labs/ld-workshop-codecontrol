#!/bin/bash
#
# Materialize the end-state of 04-contexts-and-targeting: tier-aware
# contexts in both SDKs and the beta targeting rule.
#
# Self-sufficient: writes tfvars and inits so later tracks can replay solves
# in order on a fresh VM without running challenge setups first.
#
set -euo pipefail

APP=/opt/ld/codecontrol/app
TF=/opt/ld/codecontrol/terraform

python3 "$TF/lib/patch_block.py" "$APP/server.py" "LaunchDarkly context" "$TF/release-04/pastes/server-context.py"
python3 "$TF/lib/patch_block.py" "$APP/static/app.js" "LaunchDarkly client SDK" "$TF/release-04/pastes/client-sdk.js"

cd "$TF/release-04"
echo "project_key = \"${LD_PROJECT_KEY}\"" > terraform.tfvars
terraform init -input=false
terraform apply -auto-approve

sleep 2
exit 0
