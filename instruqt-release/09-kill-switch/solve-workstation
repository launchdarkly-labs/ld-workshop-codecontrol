#!/bin/bash
#
# Materialize the end-state of 09-kill-switch: release-otto toggled off.
#
# Self-sufficient: writes tfvars and inits so later tracks can replay solves
# in order on a fresh VM without running challenge setups first. (Later
# tracks must re-enable release-otto afterward; see terraform/release-09.)
#
set -euo pipefail
source /opt/ld/ld.env

cd /opt/ld/codecontrol/terraform/release-09
echo "project_key = \"${LD_PROJECT_KEY}\"" > terraform.tfvars
terraform init -input=false
terraform apply -auto-approve
exit 0
