#!/bin/bash

set -euo pipefail

until [ -f /opt/instruqt/bootstrap/host-bootstrap-completed ]; do
    echo "Waiting for instruqt bootstrap to complete"
    sleep 1
done

# ── 1. Bootstrap the student's LaunchDarkly project (test environment only)
cd /opt/ld/codecontrol/terraform/student-bootstrap
echo "sandbox_id = \"${_SANDBOX_ID}\"" > terraform.tfvars
terraform init -input=false
terraform apply -auto-approve

export LD_PROJECT_KEY="$(terraform output -raw project_key)"

# ── 2. Pull the SDK key and client-side ID for the test environment
ENV_JSON=$(curl -fsS -X GET \
  "https://app.launchdarkly.com/api/v2/projects/${LD_PROJECT_KEY}/environments/test" \
  -H "Authorization: ${LAUNCHDARKLY_ACCESS_TOKEN}")
export LD_CLIENT_KEY=$(echo "$ENV_JSON" | jq -r ._id)
export LD_SDK_KEY=$(echo "$ENV_JSON" | jq -r .apiKey)

# Exports are guarded so a re-run of this script (Instruqt retries setup on
# failure) doesn't append duplicates.
for RC in ~/.profile ~/.bashrc; do
  grep -qF "export LD_PROJECT_KEY=" "$RC" 2>/dev/null || {
    echo "" >> "$RC"
    echo "export LD_PROJECT_KEY=\"$LD_PROJECT_KEY\"" >> "$RC"
    echo "export LD_CLIENT_KEY=${LD_CLIENT_KEY}" >> "$RC"
    echo "export LD_SDK_KEY=${LD_SDK_KEY}" >> "$RC"
  }
done

# ── 3. Mint a scoped API token restricted to this project only. The
# operator's LAUNCHDARKLY_ACCESS_TOKEN stays out of the participant's
# env; this per-lab token lives in .env for app-side REST calls (e.g.
# the auto-remediation flag flip in the Observability track). Blast
# radius is bounded by the project scope; the project is destroyed at
# cleanup.
# Re-run safety: if a previous run of this script already minted a token,
# delete it first so tokens don't accumulate in the operator account.
if [ -f /opt/ld/.ld_lab_token_id ]; then
  OLD_TOKEN_ID=$(cat /opt/ld/.ld_lab_token_id)
  curl -fsS -X DELETE \
    "https://app.launchdarkly.com/api/v2/tokens/${OLD_TOKEN_ID}" \
    -H "Authorization: ${LAUNCHDARKLY_ACCESS_TOKEN}" || true
fi
TOKEN_JSON=$(curl -fsS -X POST \
  "https://app.launchdarkly.com/api/v2/tokens" \
  -H "Authorization: ${LAUNCHDARKLY_ACCESS_TOKEN}" \
  -H "Content-Type: application/json" \
  --data-raw "$(jq -n \
    --arg name "Lab token: ${LD_PROJECT_KEY}" \
    --arg proj "${LD_PROJECT_KEY}" \
    '{name: $name, inlineRole: [{effect: "allow", actions: ["*"], resources: [("proj/" + $proj), ("proj/" + $proj + ":*")]}]}')")
LD_API_TOKEN=$(echo "$TOKEN_JSON" | jq -r .token)
# Save the token's id so cleanup-workstation can delete it.
echo "$TOKEN_JSON" | jq -r ._id > /opt/ld/.ld_lab_token_id

# ── 4. Write keys into the app's .env (never the operator token)
APP_ENV=/opt/ld/codecontrol/app/.env
sed -i 's|^LD_SDK_KEY=.*|LD_SDK_KEY='"${LD_SDK_KEY}"'|g' "$APP_ENV"
sed -i 's|^LD_CLIENT_KEY=.*|LD_CLIENT_KEY='"${LD_CLIENT_KEY}"'|g' "$APP_ENV"
sed -i 's|^LD_PROJECT_KEY=.*|LD_PROJECT_KEY='"${LD_PROJECT_KEY}"'|g' "$APP_ENV"
sed -i 's|^LD_API_TOKEN=.*|LD_API_TOKEN='"${LD_API_TOKEN}"'|g' "$APP_ENV"

# ── 5. Restart the ToggleWear service with the fresh .env. Explicit
# stop/start kept for parity with the reference tracks; uvicorn's --reload
# only watches source files, so .env changes need a real restart.
service togglewear stop || true
service togglewear start
