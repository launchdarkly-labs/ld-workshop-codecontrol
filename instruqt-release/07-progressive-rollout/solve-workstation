#!/bin/bash
#
# Materialize the end-state of 07-progressive-rollout: the completed ramp
# (default rule serves true to everyone).
#
# Self-sufficient: writes tfvars and inits so later tracks can replay solves
# in order on a fresh VM without running challenge setups first.
#
set -euo pipefail

cd /opt/ld/codecontrol/terraform/release-07
echo "project_key = \"${LD_PROJECT_KEY}\"" > terraform.tfvars
terraform init -input=false
terraform apply -auto-approve
exit 0
