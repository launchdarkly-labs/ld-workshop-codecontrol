#!/bin/bash
#
# Runs when the challenge starts. Prepares the solve module; does NOT apply
# it (solve-workstation does that if the learner skips).
#
set -euo pipefail
source /opt/ld/ld.env

cd /opt/ld/codecontrol/terraform/release-03
echo "project_key = \"${LD_PROJECT_KEY}\"" > terraform.tfvars
terraform init -input=false
exit 0
