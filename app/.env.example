# ToggleWear — environment variables.
#
# At image bake time, this file is copied to `.env`. At Instruqt lab start,
# the track-level setup-workstation `sed`s real values into `.env`. For local
# development, copy this file to `.env` and fill in your own values.

# --- LaunchDarkly ---
# Server-side SDK key for the student's project (env: test).
LD_SDK_KEY=
# Client-side environment ID, used by the browser SDK in app.js.
LD_CLIENT_KEY=
# Project key, e.g. "codecontrol-<sandbox-id>".
LD_PROJECT_KEY=
# Scoped LaunchDarkly API token for participant-facing REST calls (e.g. the
# Observability track's auto-remediation flag flip). Created at track-level
# setup by exchanging the operator's LAUNCHDARKLY_ACCESS_TOKEN for a token
# whose inline role is restricted to LD_PROJECT_KEY only. The operator token
# itself never lands in .env.
LD_API_TOKEN=

# --- App knobs ---
# Soft cap on chat turns per session, kept for demo realism (Otto is canned,
# so this is not a cost control). When exceeded, /chat returns a graceful
# "demo limit reached" message.
LD_CHAT_TURN_LIMIT=30
