#!/bin/bash
#
# Verify a guarded rollout exists on recommendations-strategy (any status —
# monitoring, regressed, rolledBack, or completed all count; a learner whose
# rollout already rolled back has succeeded at this lab).
#
# A guarded rollout can only be started in the UI (no public API), so a
# learner who Skips this challenge will not pass this check — accepted, same
# as Release 08 and the adaptive trigger in 07.
#

# Lifecycle scripts don't inherit ~/.profile; the track setup wrote the keys here.
source /opt/ld/ld.env

STATUS=$(curl -s -o /tmp/ck-obs06.json -w '%{http_code}' -X GET \
  'https://app.launchdarkly.com/api/v2/flags/'$LD_PROJECT_KEY'?filter=guardedRollout:any' \
  -H 'Authorization: '$LAUNCHDARKLY_ACCESS_TOKEN)
if [ "$STATUS" != "200" ]; then
  fail-message "Couldn't reach the LaunchDarkly API (HTTP $STATUS). Click Check again in a few seconds; if it keeps happening, tell your instructor."
  exit 1
fi

GUARDED=$(jq '[.items[]?.key] | index("recommendations-strategy") != null' /tmp/ck-obs06.json)
if [ "$GUARDED" != "true" ]; then
  fail-message "No guarded rollout found on recommendations-strategy. Edit the default rule, change the served variation to Personalized, choose Guarded rollout from the Serve menu, attach User HTTP error rate, check Automatic rollback, and save."
  exit 1
fi

exit 0
