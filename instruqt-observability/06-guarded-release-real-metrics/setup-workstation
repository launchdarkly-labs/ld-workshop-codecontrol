#!/bin/bash
#
# Runs when the challenge starts. Ensures the flag is in the pre-release
# state the lab expects (default rule on bestsellers — a learner who skipped
# 04 may still be on personalized), prepares the solve module, and keeps
# traffic flowing so the guarded rollout has samples. Does NOT start the
# rollout — that is the learner's work.
#
set -euo pipefail

TF=/opt/ld/codecontrol/terraform

cd "$TF/observability-06"
echo "project_key = \"${LD_PROJECT_KEY}\"" > terraform.tfvars
terraform init -input=false

bash "$TF/lib/set-fallthrough.sh" "${LD_PROJECT_KEY}" recommendations-strategy bestsellers \
  || echo "WARNING: could not reset recommendations-strategy to bestsellers (a rollout may be active); continuing" >&2

systemctl is-active --quiet togglewear-traffic || bash "$TF/lib/traffic.sh" recs
exit 0
