#!/bin/bash
#
# Materialize the end-state of 06-guarded-release-real-metrics: the default
# rule back on bestsellers — where a learner lands after the guard rolls the
# personalized release back. Guarded rollouts cannot be started via a public
# API, so that is all a solve can honestly do.
#
# Self-sufficient: writes tfvars and inits so later tracks can replay it.
#
set -euo pipefail
source /opt/ld/ld.env

cd /opt/ld/codecontrol/terraform/observability-06
echo "project_key = \"${LD_PROJECT_KEY}\"" > terraform.tfvars
terraform init -input=false
terraform apply -auto-approve
exit 0
