#!/bin/bash
#
# Verify an adaptive trigger exists on recommendations-strategy in the test
# environment (stable API: GET .../adaptive-triggers?resourceKind=flag&
# resourceKey=...). Whether it has fired yet is not required — arming the
# safety net is the learner's work; the firing is LaunchDarkly's.
#

# Lifecycle scripts don't inherit ~/.profile; the track setup wrote the keys here.
source /opt/ld/ld.env

STATUS=$(curl -s -o /tmp/ck-obs07.json -w '%{http_code}' -X GET \
  'https://app.launchdarkly.com/api/v2/projects/'$LD_PROJECT_KEY'/environments/test/adaptive-triggers?resourceKind=flag&resourceKey=recommendations-strategy' \
  -H 'Authorization: '$LAUNCHDARKLY_ACCESS_TOKEN)
if [ "$STATUS" != "200" ]; then
  fail-message "Couldn't reach the LaunchDarkly API (HTTP $STATUS). Click Check again in a few seconds; if it keeps happening, tell your instructor."
  exit 1
fi

COUNT=$(jq '[.items[]?] | length' /tmp/ck-obs07.json)
if [ "$COUNT" == "0" ]; then
  fail-message "No adaptive trigger found on recommendations-strategy. On the flag's Targeting tab, click Add adaptive trigger under the default rule, choose User HTTP error rate as the source, set a threshold, pick Bestsellers under Switch variation to, and click Add."
  exit 1
fi

ENABLED=$(jq '[.items[]? | select(.enabled == true)] | length' /tmp/ck-obs07.json)
if [ "$ENABLED" == "0" ]; then
  fail-message "An adaptive trigger exists on recommendations-strategy but it's disabled. Enable it (pencil icon next to the trigger on the Targeting tab) so it can fire."
  exit 1
fi

exit 0
