#!/bin/bash
#
# Materialize the end-state of 04-release-monitoring: default rule back on
# bestsellers. (The autogenerated metrics come from LaunchDarkly itself.)
#
# Self-sufficient: writes tfvars and inits so later tracks can replay it.
#
set -euo pipefail
source /opt/ld/ld.env

cd /opt/ld/codecontrol/terraform/observability-04
echo "project_key = \"${LD_PROJECT_KEY}\"" > terraform.tfvars
terraform init -input=false
terraform apply -auto-approve
exit 0
