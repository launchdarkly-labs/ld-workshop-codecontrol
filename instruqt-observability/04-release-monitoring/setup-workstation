#!/bin/bash
#
# Runs when the challenge starts. Prepares the solve module and keeps the
# error signal flowing so the autogenerated metrics have fresh events for
# the learner to read. Does NOT apply the solve (the revert is the learner's
# closing step).
#
set -euo pipefail
source /opt/ld/ld.env

TF=/opt/ld/codecontrol/terraform

cd "$TF/observability-04"
echo "project_key = \"${LD_PROJECT_KEY}\"" > terraform.tfvars
terraform init -input=false

systemctl is-active --quiet togglewear-traffic || bash "$TF/lib/traffic.sh" recs
exit 0
