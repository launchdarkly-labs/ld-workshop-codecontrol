#!/bin/bash
#
# Verify (1) LaunchDarkly has autogenerated at least one metric from the
# instrumentation (the lab's object of study) and (2) the learner reverted
# the default rule to bestsellers.
#
# VERIFY: autogenerated metrics carry the "autogenerated" tag per the docs
# (home/metrics/autogen-metrics); confirm the tag value and that the
# `tags contains [...]` filter matches it on the live API.
#

ld_get() {
  local out=$1 url=$2 status
  status=$(curl -s -o "$out" -w '%{http_code}' -X GET "$url" \
    -H 'Authorization: '$LAUNCHDARKLY_ACCESS_TOKEN)
  if [ "$status" != "200" ]; then
    fail-message "Couldn't reach the LaunchDarkly API (HTTP $status). Click **Check** again in a few seconds; if it keeps happening, tell your instructor."
    exit 1
  fi
}

# filter=tags contains ["autogenerated"]  (URL-encoded)
ld_get /tmp/ck-obs04-metrics.json \
  'https://app.launchdarkly.com/api/v2/metrics/'$LD_PROJECT_KEY'?limit=50&filter=tags%20contains%20%5B%22autogenerated%22%5D'
AUTOGEN_COUNT=$(jq '[.items[]?] | length' /tmp/ck-obs04-metrics.json)
if [ "$AUTOGEN_COUNT" == "0" ]; then
  fail-message "LaunchDarkly hasn't generated any metrics from your instrumentation yet. They appear automatically once the server plugin has sent request traces with flag evaluations — make sure the previous labs' pastes are still in place, click a few products in the ToggleWear tab (including the Rollout Tote), wait a minute or two, and check again."
  exit 1
fi

ld_get /tmp/ck-obs04-flag.json \
  'https://app.launchdarkly.com/api/v2/flags/'$LD_PROJECT_KEY'/recommendations-strategy'
if [ "$(jq -r '.environments.test.on' /tmp/ck-obs04-flag.json)" != "true" ]; then
  fail-message "**recommendations-strategy** is toggled off. Turn it on and set the default rule to **Bestsellers** — we want the carousel live, just on the safe strategy."
  exit 1
fi
# Variation indexes: 0 = bestsellers, 1 = personalized.
if [ "$(jq -r '.environments.test.fallthrough.variation // "rollout"' /tmp/ck-obs04-flag.json)" != "0" ]; then
  fail-message "The metrics are there, but **recommendations-strategy** is still serving **Personalized**. Finish the lab by editing the default rule back to **Bestsellers** and saving — stop the bleeding before the next release."
  exit 1
fi

exit 0
