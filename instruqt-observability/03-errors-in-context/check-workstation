#!/bin/bash
#
# Exploratory lab: there is no learner-created artifact to validate. The
# check confirms the preconditions for what the learner was asked to look
# at still hold — instrumentation in place and the personalized strategy
# live — so a learner who undid 02 gets pointed back rather than passed.
#

# Lifecycle scripts don't inherit ~/.profile; the track setup wrote the keys here.
source /opt/ld/ld.env

APP_DIR=/opt/ld/codecontrol/app

if ! grep -q 'ObservabilityPlugin(' "$APP_DIR/server.py" || ! grep -q 'new SessionReplay.default' "$APP_DIR/static/app.js"; then
  fail-message "The observability pastes from the previous lab are missing from 'server.py' or 'static/app.js'. Re-apply them (or restart the previous challenge and click Skip) — without them there is nothing to attribute."
  exit 1
fi

STATUS=$(curl -s -o /tmp/ck-obs03.json -w '%{http_code}' -X GET \
  'https://app.launchdarkly.com/api/v2/flags/'$LD_PROJECT_KEY'/recommendations-strategy' \
  -H 'Authorization: '$LAUNCHDARKLY_ACCESS_TOKEN)
if [ "$STATUS" != "200" ]; then
  fail-message "Couldn't reach the LaunchDarkly API (HTTP $STATUS). Click Check again in a few seconds; if it keeps happening, tell your instructor."
  exit 1
fi
if [ "$(jq -r '.environments.test.fallthrough.variation // "rollout"' /tmp/ck-obs03.json)" != "1" ]; then
  fail-message "recommendations-strategy is no longer serving Personalized, so no new errors are being produced. Leave the default rule on Personalized for this lab — you'll revert it in the next one."
  exit 1
fi

exit 0
